# SiteHub Environment Variables
APP_NAME="SiteHub"
APP_MODE="personal" # 'personal' (unlimited) or 'public'
APP_ENCRYPTION_KEY="replace_with_32_byte_hex_or_secret"
PUBLIC_APP_URL="http://localhost:3000"
PUBLISH_BASE_DOMAIN="sitehub.live"
SESSION_SECRET="change_me_to_a_secure_session_secret"

# Optional Supabase (Falls back to local encrypted SQLite/JSON storage if not provided)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Pre-configured AI Provider & Integration Secrets (Can also be configured via in-app Secrets Manager)
KIRA_API_KEY=""
KIRA_CODE_API_KEY=""
NEMOTRON_API_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

