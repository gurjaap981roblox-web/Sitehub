# SiteHub Platform Variables
APP_NAME="SiteHub"
APP_MODE="personal" # 'personal' (unlimited) or 'public'
APP_BASE_URL="https://sitehub-lnuh.onrender.com"
PORT=3000

# Security & Session Secrets (Configure privately in Render dashboard)
SESSION_SECRET="" # Cryptographically secure secret string for sessions
TOKEN_ENCRYPTION_KEY="" # 32-byte secret for AES-256-GCM token encryption at rest

# GitHub OAuth Credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="https://sitehub-lnuh.onrender.com/api/authgithub/callback"

# Optional Database (Falls back to persistent file store if DATABASE_URL is not set)
DATABASE_URL=""

# Optional AI Providers (Can also be added via in-app Secrets Manager)
KIRA_API_KEY=""
KIRA_CODE_API_KEY=""
NEMOTRON_API_KEY=""


