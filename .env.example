# SiteHub — Universal AI Website Studio Environment Configuration
# Documentation for Render.com deployment and local development.
# IMPORTANT: Never commit actual secret values. Set these in the Render Dashboard -> Environment Variables.

# Platform Basics
APP_NAME="SiteHub"
APP_MODE="personal" # 'personal' (unlimited access) or 'public'
APP_BASE_URL="https://sitehub-lnuh.onrender.com"
PORT=3000

# Security & Session Secrets (Required in Production on Render)
SESSION_SECRET="" # Secure random 32+ character passphrase for cookies and sessions
TOKEN_ENCRYPTION_KEY="" # 32-byte secret for AES-256-GCM token encryption at rest

# GitHub Integration & OAuth (GitHub Settings -> Developer settings -> OAuth Apps)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="https://sitehub-lnuh.onrender.com/api/authgithub/callback"

# Optional Relational Database (PostgreSQL / Supabase / Neon / Cloud SQL)
# If left blank, SiteHub uses atomic file-backed persistence in /data directory
DATABASE_URL=""

# AI Generation Engine API Keys (Configure at least one for live AI website synthesis)
# 1. Google Gemini (Recommended — Powers Gemini 3.8 Flash high-speed website synthesis)
GEMINI_API_KEY=""

# 2. NVIDIA NIM / Nemotron (Powers Nemotron 3 Ultra architecture planning and accessibility audits)
NEMOTRON_API_KEY=""

# 3. KiraAI (Powers DeepSeek V4.1 Flash and GLM 5.1 coding engines)
KIRA_API_KEY=""
KIRA_CODE_API_KEY=""

# 4. Optional standard OpenAI / DeepSeek / Groq endpoints
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
